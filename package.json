{
  "name": "todo-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run dev:ui\"",
    "dev:ui": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "seed:mongodb": "node scripts/seed-mongodb.js",
    "dev:full": "npm run dev",
    "lint": "eslint . --ext .js,.jsx",
    "test": "vitest run",
    "test:report": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=junit.xml",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "framer-motion": "^11.2.10",
    "mongodb": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "chromedriver": "^147.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "selenium-webdriver": "^4.41.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.3",
    "wait-on": "^7.2.0"
  }
}
